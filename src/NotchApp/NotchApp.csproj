<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the Windows SDK version in the TFM gives us WinRT APIs: media sessions, power, etc. -->
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon and monitor list -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>NotchApp</RootNamespace>
    <AssemblyName>Notch</AssemblyName>
    <Product>Notch</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets/Notch.ico</ApplicationIcon>
    <Company>Notch</Company>
    <Description>A fluid, Apple-style notch for Windows</Description>
    <!-- WPF0001: Window.ThemeMode (Windows 11 Fluent theme for the Settings window) -->
    <!-- WFO0003: a WinForms-only DPI rule; this is a WPF app and the manifest is the right place -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <!-- the installer lives inside Notch.exe: it only offers itself in builds published with -p:Packaged=true -->
  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <DefineConstants>$(DefineConstants);PACKAGED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/Notch.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- keep WinForms types out of the global namespace so WPF names (Application, Point, Color…) stay unambiguous -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
