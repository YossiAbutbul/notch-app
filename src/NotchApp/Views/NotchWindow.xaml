<Window x:Class="NotchApp.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NotchApp.Controls"
        Title="Notch" Width="760" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" AllowDrop="True"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#F4F5F8"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

  <Window.Resources>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="Fg" Color="#F4F5F8"/>
    <SolidColorBrush x:Key="Dim" Color="#94F4F5F8"/>
    <SolidColorBrush x:Key="Faint" Color="#24F4F5F8"/>
    <SolidColorBrush x:Key="Card" Color="#11FFFFFF"/>

    <!-- every button: the hover glow fades in; the press (a dip sized to the button) is in PressFeedback -->
    <Style x:Key="Press" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F4F5F8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
              <Grid.RenderTransform><ScaleTransform x:Name="S"/></Grid.RenderTransform>
              <c:Pill x:Name="Bd" Background="{TemplateBinding Background}"/>
              <c:Pill x:Name="Hover" Background="#1FFFFFFF" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource Press}">
      <Setter Property="Foreground" Value="#A8F4F5F8"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <!-- section labels: sentence case, semibold, dim (WPF can't add tracking, so no all-caps) -->
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#94F4F5F8"/>
    </Style>
  </Window.Resources>

  <Canvas x:Name="Root">
    <!-- Floating style: the pill hangs a little below the top edge. This invisible strip (1/255 alpha, so it still
         catches the cursor) fills the gap above it, so the cursor resting on the very top edge stays "on" the notch. -->
    <Border x:Name="HoverGap" Background="#01000000" Height="0"/>
    <Border x:Name="Notch" Background="Black" CornerRadius="19" Width="236" Height="38" RenderTransformOrigin="0.5,0">
      <Border.RenderTransform><ScaleTransform x:Name="PressScale"/></Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect x:Name="GlowFx" ShadowDepth="6" Direction="270" BlurRadius="30" Opacity="0" Color="#FF6278" RenderingBias="Performance"/>
      </Border.Effect>
      <Canvas x:Name="Inner">

        <!-- compact: now playing -->
        <Grid x:Name="LMusic" Width="236" Height="38" Opacity="0" IsHitTestVisible="False">
          <Border x:Name="ArtSmall" Width="24" Height="24" CornerRadius="8" HorizontalAlignment="Left" Margin="7,0,0,0" Background="#33FFFFFF"/>
          <StackPanel x:Name="BarsSmall" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
        </Grid>

        <!-- compact: focus timer -->
        <Grid x:Name="LTimer" Width="206" Height="38" Opacity="0" IsHitTestVisible="False">
          <c:PieGauge x:Name="Pie" Width="22" Height="22" HorizontalAlignment="Left" Margin="8,0,0,0"/>
          <c:RollingText x:Name="TimerSmall" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                     FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="14"/>
        </Grid>

        <!-- compact: pop-ups (volume, charging, memory, timer done) -->
        <Grid x:Name="LToast" Height="40" Width="260" Opacity="0" IsHitTestVisible="False">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="ToastIconBox" Width="24" Height="24" CornerRadius="8" Margin="8,0,12,0">
            <c:Icon x:Name="ToastIcon" Width="14" Height="14" StrokeWidth="2"/>
          </Border>
          <TextBlock x:Name="ToastText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,14,0">
            <Border x:Name="ToastBar" Width="86" Height="5" CornerRadius="2.5" Background="{StaticResource Faint}" Margin="0,0,10,0" Visibility="Collapsed">
              <Border x:Name="ToastBarFill" HorizontalAlignment="Left" CornerRadius="2.5" Background="#F4F5F8" Width="40"/>
            </Border>
            <TextBlock x:Name="ToastValue" FontFamily="{StaticResource Display}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- a notification from another app: compact when it lands, opens in place to the whole message on hover -->
        <Grid x:Name="LNotif" Width="372" Height="86" Opacity="0" IsHitTestVisible="False" Background="Transparent">
          <!-- a wash of the app's colour from the icon side -->
          <Border x:Name="NotifWash"/>
          <Grid x:Name="NotifBox" Margin="20,0,22,0" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="NotifIconBox" Width="46" Height="46" CornerRadius="12" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
              <Image x:Name="NotifLogo" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="NotifLetter" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <StackPanel x:Name="NotifText" Grid.Column="2" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="NotifApp" Foreground="{StaticResource Dim}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/>
              <TextBlock x:Name="NotifWhen" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right" Text="now"/>
            </Grid>
            <TextBlock x:Name="NotifTitle" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            <TextBlock x:Name="NotifBody" Foreground="{StaticResource Dim}" FontSize="12.5" TextTrimming="CharacterEllipsis" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
            <TextBlock x:Name="NotifHint" FontSize="11.5" FontWeight="SemiBold" Margin="0,10,0,0" Visibility="Collapsed"/>
          </StackPanel>
          </Grid>
        </Grid>

        <!-- files dragged onto the notch -->
        <Grid x:Name="LDrop" Width="420" Height="118" Opacity="0" IsHitTestVisible="False">
          <Rectangle Margin="12" RadiusX="20" RadiusY="20" Stroke="#99FFBE5A" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="#12FFBE5A"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:Icon Kind="shelf" Width="30" Height="30" Foreground="#FF9F43" StrokeWidth="1.6" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="DropTitle" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" Text="Drop to keep on Shelf"/>
              <TextBlock Foreground="{StaticResource Dim}" FontSize="12" Text="Files stay here until you remove them"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- expanded: the hub -->
        <Grid x:Name="LHub" Width="600" Opacity="0" IsHitTestVisible="False">
          <StackPanel Margin="12">
            <!-- tabs: the open tab's name on the left; a row of icons that never move on the right, the pill sliding
                 between them -->
            <Grid x:Name="TabsRow" Height="32">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="TabTitle" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="8,0,12,1" TextTrimming="CharacterEllipsis">
                <TextBlock.RenderTransform><TranslateTransform x:Name="TabTitleX"/></TextBlock.RenderTransform>
              </TextBlock>
              <Grid x:Name="TrackInner" Grid.Column="1">
                <Border x:Name="TabIndicator" HorizontalAlignment="Left" Height="32" Width="80" CornerRadius="16" Background="#2C2C2F">
                  <Border.RenderTransform><TranslateTransform x:Name="TabIndicatorX"/></Border.RenderTransform>
                  <Border CornerRadius="16" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF"/>
                </Border>
                <StackPanel x:Name="TabButtons" Orientation="Horizontal">
                <Button x:Name="TabNow" Style="{StaticResource Tab}" Tag="now" ToolTip="Now playing">
                  <StackPanel Orientation="Horizontal"><c:Icon Kind="now" Width="16" Height="16"/><Border ClipToBounds="True" Width="0"><TextBlock Text="Now playing" Margin="7,0,0,0" Opacity="0"/></Border></StackPanel>
                </Button>
                <Button x:Name="TabTimer" Style="{StaticResource Tab}" Tag="timer" ToolTip="Timer">
                  <StackPanel Orientation="Horizontal"><c:Icon Kind="clock" Width="16" Height="16"/><Border ClipToBounds="True" Width="0"><TextBlock Text="Timer" Margin="7,0,0,0" Opacity="0"/></Border></StackPanel>
                </Button>
                <Button x:Name="TabNotif" Style="{StaticResource Tab}" Tag="notif" ToolTip="Notifications">
                  <StackPanel Orientation="Horizontal"><c:Icon Kind="bell" Width="16" Height="16"/><Border ClipToBounds="True" Width="0"><TextBlock Text="Notifications" Margin="7,0,0,0" Opacity="0"/></Border></StackPanel>
                </Button>
                <Button x:Name="TabClip" Style="{StaticResource Tab}" Tag="clip" ToolTip="Clipboard">
                  <StackPanel Orientation="Horizontal"><c:Icon Kind="clip" Width="16" Height="16"/><Border ClipToBounds="True" Width="0"><TextBlock Text="Clipboard" Margin="7,0,0,0" Opacity="0"/></Border></StackPanel>
                </Button>
                <Button x:Name="TabShelf" Style="{StaticResource Tab}" Tag="shelf" ToolTip="Shelf">
                  <StackPanel Orientation="Horizontal"><c:Icon Kind="shelf" Width="16" Height="16"/><Border ClipToBounds="True" Width="0"><TextBlock Text="Shelf" Margin="7,0,0,0" Opacity="0"/></Border></StackPanel>
                </Button>
                <Button x:Name="TabDev" Style="{StaticResource Tab}" Tag="dev" ToolTip="Devices">
                  <StackPanel Orientation="Horizontal"><c:Icon Kind="wifi" Width="16" Height="16"/><Border ClipToBounds="True" Width="0"><TextBlock Text="Devices" Margin="7,0,0,0" Opacity="0"/></Border></StackPanel>
                </Button>
                <Button x:Name="TabApps" Style="{StaticResource Tab}" Tag="apps" ToolTip="Apps">
                  <StackPanel Orientation="Horizontal"><c:Icon Kind="apps" Width="16" Height="16"/><Border ClipToBounds="True" Width="0"><TextBlock Text="Apps" Margin="7,0,0,0" Opacity="0"/></Border></StackPanel>
                </Button>
                <Button x:Name="TabSystem" Style="{StaticResource Tab}" Tag="system" ToolTip="System">
                  <StackPanel Orientation="Horizontal"><c:Icon Kind="system" Width="16" Height="16"/><Border ClipToBounds="True" Width="0"><TextBlock Text="System" Margin="7,0,0,0" Opacity="0"/></Border></StackPanel>
                </Button>
                </StackPanel>
              </Grid>
              <Button x:Name="GearBtn" Grid.Column="3" Style="{StaticResource Press}" Width="32" Height="32" Foreground="#A8F4F5F8" ToolTip="Settings">
                <c:Icon Kind="gear" Width="16" Height="16"/>
              </Button>
            </Grid>

            <Canvas x:Name="Viewport" Margin="0,12,0,0" Height="270" ClipToBounds="True" Width="576">
              <StackPanel x:Name="Strip" Orientation="Horizontal">
                <StackPanel.RenderTransform><TranslateTransform x:Name="StripX"/></StackPanel.RenderTransform>

                <!-- Now: music + timer -->
                <!-- Now: the player, full width -->
                <Grid x:Name="PaneNow" Width="576" Height="140" VerticalAlignment="Top">
                  <Border Background="{StaticResource Card}" CornerRadius="20" Padding="12">
                    <Grid>
                      <Grid x:Name="MusicCard">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="ArtLarge" CornerRadius="14" Background="#33FFFFFF"/>
                        <Grid Grid.Column="2" Margin="0,2,4,0">
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="8"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                              <TextBlock x:Name="SongTitle" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="17" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                              <TextBlock x:Name="SongArtist" Foreground="{StaticResource Dim}" FontSize="13" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel x:Name="BarsLarge" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0" Height="18"/>
                          </Grid>
                          <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SongPos" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Text="0:00"/>
                            <!-- click or drag to seek (when the player allows it); a taller transparent strip makes it easy to hit -->
                            <Grid x:Name="SongTrack" Grid.Column="1" Height="14" Background="Transparent">
                              <Border Height="5" CornerRadius="2.5" Background="#29FFFFFF" VerticalAlignment="Center">
                                <Border x:Name="SongBar" HorizontalAlignment="Left" CornerRadius="2.5" Background="#E6F4F5F8" Width="0"/>
                              </Border>
                            </Grid>
                            <TextBlock x:Name="SongLen" Grid.Column="2" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Text="-0:00"/>
                          </Grid>
                          <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <Button x:Name="PrevBtn" Style="{StaticResource Press}" Width="52" Height="38" ToolTip="Previous"><c:Icon Kind="back" Width="22" Height="22"/></Button>
                              <Button x:Name="PlayBtn" Style="{StaticResource Press}" Width="56" Height="38" Margin="18,0">
                                <c:Icon x:Name="PlayIcon" Kind="pause" Width="26" Height="26"/>
                              </Button>
                              <Button x:Name="NextBtn" Style="{StaticResource Press}" Width="52" Height="38" ToolTip="Next"><c:Icon Kind="fwd" Width="22" Height="22"/></Button>
                            </StackPanel>
                            <!-- volume of the current output: click the speaker to mute, click/drag the bar or scroll on it -->
                            <StackPanel x:Name="VolRow" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <Button x:Name="MuteBtn" Style="{StaticResource Press}" Width="26" Height="26" Foreground="{StaticResource Dim}" ToolTip="Mute">
                                <c:Icon x:Name="MuteIcon" Kind="speaker" Width="15" Height="15"/>
                              </Button>
                              <Grid x:Name="VolTrack" Width="72" Height="22" Margin="4,0,0,0" Background="Transparent" Cursor="Hand">
                                <Border Height="5" CornerRadius="2.5" Background="#29FFFFFF" VerticalAlignment="Center"/>
                                <Border x:Name="VolBar" Height="5" CornerRadius="2.5" Background="#E6F4F5F8" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                              </Grid>
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Grid>
                      <!-- nothing playing: one short row instead of an empty player (the pane shrinks to fit it) -->
                      <Grid x:Name="NoMusic" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10">
                          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A2D3A" Offset="0"/><GradientStop Color="#15161C" Offset="1"/></LinearGradientBrush></Border.Background>
                          <c:Icon Kind="now" Width="18" Height="18" Foreground="{StaticResource Dim}"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="Nothing playing" FontWeight="SemiBold" FontSize="13.5"/>
                          <TextBlock Text="Play music or a video in any app to control it here" Foreground="{StaticResource Dim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </Grid>

                <!-- Timer: like the iPhone's timer Live Activity. Round tinted controls on the left (the play button wears the
                     progress ring), big light digits on the right. The editor replaces it in place. -->
                <Grid x:Name="PaneTimer" Width="576" Height="140" VerticalAlignment="Top">
                  <Grid x:Name="TimerRow" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="TimerRowScale"/></Grid.RenderTransform>
                    <Border Background="{StaticResource Card}" CornerRadius="20" Padding="22,0,24,0" ClipToBounds="True">
                      <Grid>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="64" Height="64">
                              <c:ProgressRing x:Name="Dial" Thickness="3.5"/>
                              <Button x:Name="TimerPlay" Style="{StaticResource Press}" Width="52" Height="52" ToolTip="Start">
                                <c:Icon x:Name="TimerPlayIcon" Kind="play" Width="20" Height="20"/>
                              </Button>
                            </Grid>
                            <Button x:Name="TimerReset" Style="{StaticResource Press}" Width="52" Height="52" Margin="12,0,0,0" Background="#2C2C2E" ToolTip="Restart this session">
                              <c:Icon Kind="reset" Width="18" Height="18" StrokeWidth="2"/>
                            </Button>
                            <Button x:Name="TimerAdd" Style="{StaticResource Press}" Width="52" Height="52" Margin="10,0,0,0" Background="#2C2C2E" ToolTip="Add 5 minutes">
                              <TextBlock Text="+5" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold"/>
                            </Button>
                            <Button x:Name="TimerEditBtn" Style="{StaticResource Press}" Width="52" Height="52" Margin="10,0,0,0" Background="#2C2C2E" ToolTip="Edit lengths">
                              <c:Icon Kind="sliders" Width="18" Height="18" StrokeWidth="2"/>
                            </Button>
                          </StackPanel>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,2">
                              <Ellipse x:Name="PhaseDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"/>
                              <TextBlock x:Name="PhaseText" FontSize="13" FontWeight="SemiBold" Text="Focus"/>
                              <TextBlock x:Name="PhaseCount" FontSize="13" Foreground="{StaticResource Dim}"/>
                            </StackPanel>
                            <!-- just the time: the edit button opens the editor -->
                            <Border HorizontalAlignment="Right" Padding="8,0,4,0" Height="62">
                              <c:RollingText x:Name="DialTime" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="50" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EndsAt" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,6,4,0"/>
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </Grid>

                  <!-- editor: iOS picker wheels on one shared band for the three lengths; sessions, auto-start and Done beside them -->
                  <Grid x:Name="TimerEditor" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="TimerEditorScale" ScaleX="0.97" ScaleY="0.97"/></Grid.RenderTransform>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Card}" CornerRadius="20" ClipToBounds="True">
                      <Grid Margin="8,8,8,4">
                        <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <UniformGrid Rows="1">
                          <TextBlock x:Name="CapFocus" Text="Focus" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                          <TextBlock x:Name="CapBreak" Text="Break" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                          <TextBlock x:Name="CapLong" Text="Long break" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </UniformGrid>
                        <Grid Grid.Row="1">
                          <Border Height="28" CornerRadius="9" Background="#1FFFFFFF" VerticalAlignment="Center"/>
                          <UniformGrid Rows="1">
                            <UniformGrid.OpacityMask>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset="0.3"/>
                                <GradientStop Color="Black" Offset="0.7"/><GradientStop Color="Transparent" Offset="1"/>
                              </LinearGradientBrush>
                            </UniformGrid.OpacityMask>
                            <c:WheelPicker x:Name="FocusWheel" Min="1" Max="180"/>
                            <c:WheelPicker x:Name="BreakWheel" Min="1" Max="30"/>
                            <c:WheelPicker x:Name="LongWheel" Min="5" Max="60" Step="5"/>
                          </UniformGrid>
                        </Grid>
                      </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="20" Padding="14,10,14,12">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="EditRows" VerticalAlignment="Center"/>
                        <Button x:Name="EditDone" Grid.Row="1" Style="{StaticResource Press}" Height="34" FontSize="13.5" FontWeight="SemiBold" Foreground="#15110A" Content="Done"/>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>

                <!-- Notifications from other apps. Lists sit in one grouped card, like every other pane's content. -->
                <StackPanel x:Name="PaneNotif" Width="576" VerticalAlignment="Top">
                  <Grid Height="26" Margin="8,0,0,8">
                    <TextBlock x:Name="NotifCount" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Text="Recent"/>
                    <Button x:Name="NotifClear" Style="{StaticResource Press}" HorizontalAlignment="Right" Height="26" Padding="11,0" Background="{StaticResource Faint}" FontWeight="SemiBold" FontSize="11.5" Content="Clear"/>
                  </Grid>
                  <Border Background="{StaticResource Card}" CornerRadius="20" Padding="4">
                    <ScrollViewer x:Name="NotifScroll" VerticalScrollBarVisibility="Hidden" Height="166" PanningMode="VerticalOnly">
                      <StackPanel x:Name="NotifList" Margin="0,0,0,-4"/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>

                <!-- Clipboard -->
                <Grid x:Name="PaneClip" Width="576" VerticalAlignment="Top">
                <StackPanel x:Name="ClipListView" VerticalAlignment="Top">
                  <Grid Height="26" Margin="8,0,0,8">
                    <TextBlock x:Name="ClipCount" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Text="Recent"/>
                    <Button x:Name="ClipClear" Style="{StaticResource Press}" HorizontalAlignment="Right" Height="26" Padding="11,0" Background="{StaticResource Faint}" FontWeight="SemiBold" FontSize="11.5" Content="Clear unpinned"/>
                  </Grid>
                  <Border Background="{StaticResource Card}" CornerRadius="20" Padding="4">
                    <ScrollViewer x:Name="ClipScroll" VerticalScrollBarVisibility="Hidden" Height="166" PanningMode="VerticalOnly">
                      <StackPanel x:Name="ClipList" Margin="0,0,0,-4"/>
                    </ScrollViewer>
                  </Border>
                </StackPanel>

                <!-- a copied photo, big: it grows out of its thumbnail in the list and goes back into it -->
                <Grid x:Name="ClipViewer" VerticalAlignment="Top" Visibility="Collapsed">
                  <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid x:Name="ViewBar">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Button x:Name="ViewBack" Style="{StaticResource Press}" Height="26" Padding="6,0,12,0" Background="{StaticResource Faint}" FontWeight="SemiBold" FontSize="11.5" ToolTip="Back to the list">
                        <StackPanel Orientation="Horizontal"><c:Icon Kind="chev" Width="13" Height="13" StrokeWidth="2.2" Margin="0,0,3,0"/><TextBlock Text="Clipboard" VerticalAlignment="Center"/></StackPanel>
                      </Button>
                      <TextBlock x:Name="ViewInfo" Grid.Column="1" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Button x:Name="ViewPrev" Style="{StaticResource Press}" Width="26" Height="26" Background="{StaticResource Faint}" ToolTip="Newer image">
                        <c:Icon Kind="chev" Width="13" Height="13" StrokeWidth="2.2"/>
                      </Button>
                      <TextBlock x:Name="ViewCount" Foreground="{StaticResource Dim}" FontSize="11.5" VerticalAlignment="Center" Margin="7,0" MinWidth="34" TextAlignment="Center"/>
                      <Button x:Name="ViewNext" Style="{StaticResource Press}" Width="26" Height="26" Background="{StaticResource Faint}" ToolTip="Older image" Margin="0,0,10,0">
                        <c:Icon Kind="chev" Width="13" Height="13" StrokeWidth="2.2" RenderTransformOrigin="0.5,0.5"><c:Icon.RenderTransform><ScaleTransform ScaleX="-1"/></c:Icon.RenderTransform></c:Icon>
                      </Button>
                      <Button x:Name="ViewOpen" Style="{StaticResource Press}" Height="26" Padding="11,0" Background="{StaticResource Faint}" FontWeight="SemiBold" FontSize="11.5" Content="Open" ToolTip="Open in your photo app"/>
                      <Button x:Name="ViewCopy" Style="{StaticResource Press}" Height="26" Padding="11,0" Margin="4,0" Background="{StaticResource Faint}" FontWeight="SemiBold" FontSize="11.5" Content="Copy"/>
                      <Button x:Name="ViewSave" Style="{StaticResource Press}" Height="26" Padding="11,0" Background="#F4F5F8" Foreground="Black" FontWeight="SemiBold" FontSize="11.5" Content="Save" ToolTip="Save to Downloads"/>
                    </StackPanel>
                  </Grid>
                  <Border x:Name="ViewCard" Grid.Row="2" Background="{StaticResource Card}" CornerRadius="20" Padding="8">
                    <Border x:Name="ViewImg" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
                </Grid>

                <!-- Shelf -->
                <StackPanel x:Name="PaneShelf" Width="576" VerticalAlignment="Top">
                  <Grid Height="26" Margin="8,0,0,8">
                    <TextBlock x:Name="ShelfCount" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Text="Shelf"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button x:Name="ShelfAdd" Style="{StaticResource Press}" Height="26" Padding="11,0" Background="{StaticResource Faint}" FontWeight="SemiBold" FontSize="11.5" Content="Add files"/>
                      <Button x:Name="ShelfClear" Style="{StaticResource Press}" Height="26" Padding="11,0" Margin="4,0" Background="{StaticResource Faint}" FontWeight="SemiBold" FontSize="11.5" Content="Clear"/>
                      <Button x:Name="ShelfSave" Style="{StaticResource Press}" Height="26" Padding="11,0" Background="#F4F5F8" Foreground="Black" FontWeight="SemiBold" FontSize="11.5" Content="Save all"/>
                    </StackPanel>
                  </Grid>
                  <ScrollViewer x:Name="ShelfScroll" VerticalScrollBarVisibility="Hidden" Height="120" PanningMode="VerticalOnly">
                    <UniformGrid x:Name="ShelfGrid" Columns="4" VerticalAlignment="Top" Margin="0,0,-8,-8"/>
                  </ScrollViewer>
                </StackPanel>

                <!-- Devices -->
                <Grid x:Name="PaneDev" Width="576" Height="152" VerticalAlignment="Top">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <UniformGrid x:Name="DevTiles" Rows="2" Columns="2" Margin="0,0,-8,-8"/>
                  <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="20" Padding="12,8,8,6">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" Height="26" Margin="0,0,0,2">
                        <TextBlock Style="{StaticResource Label}" Text="Bluetooth devices" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button x:Name="BtManage" Style="{StaticResource Press}" HorizontalAlignment="Right" Height="24" Padding="10,0" Background="{StaticResource Faint}" FontWeight="SemiBold" FontSize="11" Content="Pair or connect"/>
                      </Grid>
                      <ScrollViewer x:Name="DevScroll" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                        <StackPanel x:Name="DevList"/>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </Grid>

                <!-- Apps -->
                <Grid x:Name="PaneApps" Width="576" VerticalAlignment="Top">
                  <ScrollViewer x:Name="AppsScroll" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                    <UniformGrid x:Name="AppsGrid" Columns="6" VerticalAlignment="Top" Margin="0,0,-8,-8"/>
                  </ScrollViewer>
                </Grid>

                <!-- System -->
                <Grid x:Name="PaneSystem" Width="576" Height="144" VerticalAlignment="Top">
                  <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="8"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition x:Name="BattGapCol" Width="8"/><ColumnDefinition x:Name="BattCol"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Card}" CornerRadius="20" Padding="16,12">
                      <DockPanel>
                        <Grid DockPanel.Dock="Top"><TextBlock Style="{StaticResource Label}" Text="CPU"/><TextBlock x:Name="CpuCores" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                        <TextBlock x:Name="CpuValue" DockPanel.Dock="Top" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="22" Margin="0,6,0,0" Text="0%"/>
                        <Canvas x:Name="CpuSpark" Height="26" VerticalAlignment="Bottom" ClipToBounds="True">
                          <Polyline x:Name="CpuLine" Stroke="#0A84FF" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                        </Canvas>
                      </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="20" Padding="16,12">
                      <DockPanel>
                        <Grid DockPanel.Dock="Top"><TextBlock Style="{StaticResource Label}" Text="Memory"/><TextBlock x:Name="MemPct" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                        <TextBlock x:Name="MemValue" DockPanel.Dock="Top" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="22" Margin="0,6,0,0"/>
                        <Border Height="8" CornerRadius="4" Background="{StaticResource Faint}" VerticalAlignment="Bottom">
                          <Border x:Name="MemBar" HorizontalAlignment="Left" CornerRadius="4" Background="#30D158" Width="0"/>
                        </Border>
                      </DockPanel>
                    </Border>
                    <Border x:Name="BattCard" Grid.Column="4" Background="{StaticResource Card}" CornerRadius="20" Padding="16,12">
                      <DockPanel>
                        <Grid DockPanel.Dock="Top"><TextBlock Style="{StaticResource Label}" Text="Battery"/><c:Icon x:Name="BattBolt" Kind="bolt" Width="12" Height="12" HorizontalAlignment="Right" Foreground="#30D158" Visibility="Collapsed"/></Grid>
                        <TextBlock x:Name="BattValue" DockPanel.Dock="Top" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="22" Margin="0,6,0,0"/>
                        <TextBlock x:Name="BattState" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Bottom"/>
                      </DockPanel>
                    </Border>
                  </Grid>
                  <Grid Grid.Row="2">
                    <TextBlock x:Name="SysFoot" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button x:Name="FreeMemBtn" Style="{StaticResource Press}" HorizontalAlignment="Right" Height="26" Padding="12,0" Background="#F4F5F8" Foreground="Black" FontWeight="SemiBold" FontSize="11.5" Content="Free up memory"/>
                  </Grid>
                </Grid>
              </StackPanel>
            </Canvas>
          </StackPanel>
        </Grid>
      </Canvas>
    </Border>

    <!-- Line style: the closed notch is a thin bar at the top edge (the shape under it is an invisible strip you can
         hover). Idle it's grey; with music or the timer it's a progress line in their colour. -->
    <Grid x:Name="LineBar" Height="4" Opacity="0" IsHitTestVisible="False">
      <Border x:Name="LineTrack" CornerRadius="0,0,2,2" Background="#6A6A74"/>
      <Border x:Name="LineFill" CornerRadius="0,0,2,2" HorizontalAlignment="Left" Width="0"/>
    </Grid>
  </Canvas>
</Window>
