<Window x:Class="NotchApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch settings" Width="920" Height="660" MinWidth="740" MinHeight="480"
        ThemeMode="Dark" WindowStartupLocation="CenterScreen" Icon="/Assets/Notch.ico"
        Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5">
  <!-- Today's Apple look, built from Windows 11's own materials: the window is Mica (the theme's backdrop, tinted by the
       desktop, like macOS's window material), and on it float glass layers: a sidebar inset from the window's edges
       and rounded groups, each a faint translucent fill with a brighter top edge where light catches it. Controls are
       capsules. No background is set here on purpose: that is what lets Mica show through. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="Secondary" Color="#A6EBEBF5"/>

    <!-- a glass capsule button: it dims the moment it's pressed, not on release -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F5F5F7"/>
      <Setter Property="Background" Value="#1FFFFFFF"/>
      <Setter Property="Padding" Value="14,5,14,6"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"
                    BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#B30A84FF"/><Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the one default action on a page (Install an update): a tinted capsule -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="14" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" BorderBrush="#4DFFFFFF" BorderThickness="0,1,0,0">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A9BFF" Offset="0"/><GradientStop Color="#0A84FF" Offset="1"/></LinearGradientBrush></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- the sidebar: a glass pane floating on the window, inset from its edges, with corners concentric to the window's -->
    <!-- its shadow lives on a layer of its own, so the pane's text stays crisp -->
    <Border Margin="8,0,0,8" CornerRadius="14" Background="#01000000">
      <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.3" RenderingBias="Performance"/></Border.Effect>
    </Border>
    <Border Margin="8,0,0,8" CornerRadius="14" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1,1,1,0.5">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,10,8,10">
        <StackPanel>
          <Border x:Name="AppCard" Margin="0,2,0,12"/>
          <StackPanel x:Name="Nav"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,6,34,32">
      <StackPanel x:Name="Page" MaxWidth="660" HorizontalAlignment="Stretch">
        <StackPanel.RenderTransform><TranslateTransform x:Name="PageShift"/></StackPanel.RenderTransform>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
