<Window x:Class="NotchApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch settings" Width="880" Height="620" MinWidth="700" MinHeight="460"
        ThemeMode="Dark" WindowStartupLocation="CenterScreen" Icon="/Assets/Notch.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <ListBox x:Name="Nav" Margin="8,8,4,12" BorderThickness="0" Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,4,32,32">
      <StackPanel x:Name="Page" MaxWidth="760" HorizontalAlignment="Stretch"/>
    </ScrollViewer>
  </Grid>
</Window>
